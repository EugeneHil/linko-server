# --- linko shared ignores (managed by linko-core/tooling/sync-shared.sh) ---
# macOS
.DS_Store
# Xcode / Tuist
DerivedData/
xcuserdata/
*.xcuserstate
*.xcodeproj/
*.xcworkspace/
Derived/
# CMake
build/
cmake-build-*/
out/
# Visual Studio
.vs/
*.user
# vcpkg
vcpkg_installed/
# Python
__pycache__/
*.pyc
# Secrets and signing material: never commit
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.p8
*.cer
*.mobileprovision
config.local.json
# Runtime data
data/
# Tooling
.superpowers/
# Coverage
*.profraw
coverage/
# --- end linko shared ignores ---

# linko-server runtime config and TLS material (docs/deploy.md section 3):
# they carry the TURN shared secret and the TLS key material, so keep them
# out of git even if someone drops them inside the working tree. The deploy
# runbook places them outside the repo tree (C:\linko\) - this is a net.
config.json
server.crt
certs/

# CTest artifacts
Testing/
